<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <% if(nav == true) { %>
    <!-- Navigation Bar -->
    <div class="w-full px-4 sm:px-8 md:px-14 py-3 flex flex-wrap justify-between items-center bg-zinc-600 text-white">
      <!-- Logo and Brand -->
      <div class="flex items-center gap-4">
        <img class="w-10 h-10 sm:w-12 sm:h-12" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSWhYXJEsqPEscpE30APrKz_ZUYR38IAcgcqA&s" alt="Pinterest Logo">
        <a href="/profile"><h3 class="text-xl sm:text-2xl font-bold">Pin</h3></a>
      </div>
  
      <!-- Hamburger Menu for Mobile -->
      <button id="menu-toggle" class="block sm:hidden text-2xl">
        <i class="ri-menu-line"></i>
      </button>
  
      <!-- Navigation Links -->
      <div id="nav-links" class="hidden sm:flex sm:items-center gap-6 sm:gap-10 w-full sm:w-auto mt-4 sm:mt-0">
        <a href="/profile" class="block sm:inline-block text-lg sm:text-base">Profile</a>
        <a href="/feed" class="block sm:inline-block text-lg sm:text-base">Feed</a>
        <a class="px-3 py-2 bg-red-700 text-white rounded-lg text-lg sm:text-base" href="/">Logout</a>
      </div>
    </div>
  <% } else { %>
    <!-- Minimal Navigation Bar -->
    <div class="w-full px-4 sm:px-8 md:px-14 py-3 flex justify-between bg-zinc-600 text-white">
      <div class="flex items-center gap-4">
        <img class="w-10 h-10 sm:w-12 sm:h-12" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSWhYXJEsqPEscpE30APrKz_ZUYR38IAcgcqA&s" alt="Pinterest Logo">
        <a href="/"><h3 class="text-xl sm:text-2xl font-bold">Pin</h3></a>
      </div>
    </div>
  <% } %>
  
  <script>
    // Toggle mobile menu
    document.getElementById('menu-toggle').addEventListener('click', function () {
      const navLinks = document.getElementById('nav-links');
      navLinks.classList.toggle('hidden');
    });
  </script>

   
