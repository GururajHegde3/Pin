<%include ./partials/header.ejs %>
<div class="container w-full min-h-screen bg-zinc-800 pt-1 text-white px-4 sm:px-6 md:px-8">
    <form id="uploadform" hidden action="/fileupload" method="post" enctype="multipart/form-data">
        <input type="file" name="image">
    </form>
    <div class="profdets flex flex-col items-center mt-10 sm:mt-20">
        <div class="relative">
            <span id="uploadicon" class="w-8 h-8 absolute bottom-0 right-0 rounded-full flex items-center justify-center bg-zinc-200 cursor-pointer">
                <i class="ri-edit-2-fill text-zinc-800"></i>
            </span>
            <div class="w-24 h-24 sm:w-32 sm:h-32 bg-zinc-100 rounded-full overflow-hidden">
                <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profileImage %>" alt="<%= user.username %>'s profile">
            </div>
        </div>
       
        <h1 class="text-2xl sm:text-3xl font-semibold mt-3"><%=user.username%></h1>
       
        <a href="/add" class="mt-4 font-semibold px-8 sm:px-10 py-2 rounded-lg bg-red-700 text-center">Add New Post</a> 
    </div>
    
    <div class="cards flex flex-wrap justify-center sm:justify-start gap-4 sm:gap-6 md:gap-10 px-2 sm:px-6 md:px-10 mt-8 sm:mt-10">
        <div class="card">
            <div class="w-36 h-36 sm:w-44 sm:h-44 md:w-52 md:h-52 bg-zinc-200 rounded-lg overflow-hidden">
                <a href="/show/posts"> 
                    <img class="w-full h-full object-cover" src="/images/uploads/<%=user?.posts[0]?.image %>" alt="Your pins">
                </a>
            </div>
            <a href="/show/posts" class="inline-block text-lg sm:text-xl font-semibold mt-2 sm:mt-3 opacity-90 text-white">Your Pins</a>
            <h5 class="text-white font-medium opacity-90"><%= user.posts.length %></h5>
        </div>
    </div>
</div>

<script>
  // Trigger the file input when the upload icon is clicked
document.querySelector("#uploadicon").addEventListener("click", function () {
    document.querySelector("#uploadform input").click();
});

// Listen for file selection, then submit the form
document.querySelector("#uploadform input").addEventListener("change", function () {
    if (this.files.length > 0) {  // Check if a file is selected
        document.querySelector("#uploadform").submit();
    } else {
        alert('Please select a file before uploading.');
    }
});
</script>
<%include ./partials/footer.ejs %>

